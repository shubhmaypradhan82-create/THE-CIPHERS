# Leave as-is for easiest demo: SQLite file is created automatically.
DATABASE_URL=sqlite:///./email_threat_detection.db

# Optional PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/email_threat_detection

# Optional team cybersecurity/AI services:
# CYBER_ENGINE_URL=http://localhost:9000/analyze
# AI_API_URL=http://localhost:9100/analyze
# AI_API_KEY=

# Optional API key for external cybersecurity engine:
# CYBER_ENGINE_API_KEY=

# Integrated forensic engine safety/performance controls
FORENSIC_DNS_TIMEOUT=2
FORENSIC_HTTP_TIMEOUT=3
FORENSIC_TLS_TIMEOUT=3
FORENSIC_INTEL_TIMEOUT=5
FORENSIC_IP_INTEL=false

# CHIPERS administrator bootstrap credentials (set these before first admin login)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Set true once if you need to replace the stored admin password from ADMIN_PASSWORD.
RESET_ADMIN_PASSWORD=false
